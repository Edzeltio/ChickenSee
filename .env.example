# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then copy the values from
# Project Settings → API.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ── Tapo C530WS IP Camera ─────────────────────────────────────────────────────
# 1. Open the Tapo app → select your C530WS → Settings (⚙)
# 2. Advanced Settings → RTSP → Enable RTSP, set a username and password
# 3. Use local mode for the same LAN, remote mode for a VPN/NAT endpoint, or
#    auto to try local first and remote second.
TAPO_CONNECTION_MODE=auto
TAPO_IP=192.168.1.100
TAPO_USER=admin
TAPO_PASSWORD=your-rtsp-password

# Stream quality: "main" = high-quality (1080p/2K), "sub" = lower-res (~360p)
# Use "sub" on slow or crowded Wi-Fi networks.
TAPO_STREAM=main

# ── Optional remote Tapo endpoint ────────────────────────────────────────────
# Option A: provide a remote host and forwarded RTSP port. The router/VPN must
# route that port to the camera's internal port 554.
# TAPO_REMOTE_HOST=camera.example.com
# TAPO_REMOTE_PORT=8554
#
# Option B: provide the complete RTSP URL. This is useful for a VPN, reverse
# proxy, or a non-standard stream path. Keep credentials out of source control.
# TAPO_REMOTE_RTSP_URL=rtsp://username:password@camera.example.com:8554/stream1

# ── Optional overrides ────────────────────────────────────────────────────────
# USB serial port; leave blank to auto-detect an Arduino on Windows or Linux.
# SERIAL_PORT=COM4
# Run without Arduino hardware while testing the mini PC.
# SIMULATE=1
# SIMULATION_INTERVAL_S=2
# Set false on a headless Linux mini PC.
# SHOW_PREVIEW=false

# Custom path for the local SQLite database (defaults to data/sensor_data.db)
# DB_PATH=/home/pi/sensor_data.db

# Seconds to wait before retrying a dropped RTSP connection (default: 5)
# TAPO_RECONNECT_DELAY_S=5
